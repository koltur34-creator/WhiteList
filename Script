-- Kullanicilara verecegin loader: ana script'i GitHub'dan indirip calistirir
local SCRIPT_URL = "https://raw.githubusercontent.com/koltur34-creator/WhiteList/refs/heads/main/ProFortnitePlayers.lua"

local ok, kod = pcall(function()
	return game:HttpGet(SCRIPT_URL .. "?t=" .. os.time()) -- ?t= GitHub onbellegini atlatir
end)
if not ok or type(kod) ~= "string" or #kod == 0 then
	warn("[Loader] Script indirilemedi:", kod)
	return
end

local fn, hata = loadstring(kod)
if not fn then
	warn("[Loader] Script derlenemedi:", hata)
	return
end

fn()
